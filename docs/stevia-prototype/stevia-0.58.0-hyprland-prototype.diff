+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#define G_LOG_DOMAIN "pos-osk-gesture"
+
+#include "pos-osk-gesture.h"
+
+/* Fraction of the widget width a letter key must slide left to delete */
+#define POS_OSK_CHAR_GESTURE_FRACTION 0.25
+
+/**
+ * pos_osk_classify_delete_gesture:
+ * @start_is_bs: Whether the touch started on the BackSpace key
+ * @dx: Horizontal offset from the touch start in pixels (negative is left)
+ * @dy: Vertical offset from the touch start in pixels
+ * @key_width: Width of the start key in pixels
+ * @widget_width: Width of the keyboard widget in pixels
+ *
+ * Classifies a touch movement as a delete gesture. Starting on
+ * BackSpace, sliding further left than one key width is a word delete
+ * that lasts while the finger stays down. Starting on another key,
+ * a mostly horizontal slide to the left over a quarter of the widget
+ * width is a single delete.
+ *
+ * This is pure so it can be unit tested without a display.
+ *
+ * Returns: The kind of delete gesture
+ */
+PosOskDeleteGesture
+pos_osk_classify_delete_gesture (gboolean start_is_bs,
+                                 double   dx,
+                                 double   dy,
+                                 double   key_width,
+                                 double   widget_width)
+{
+  if (dx >= 0.0)
+    return POS_OSK_DELETE_GESTURE_NONE;
+
+  if (start_is_bs) {
+    if (key_width <= 0.0 || -dx <= key_width)
+      return POS_OSK_DELETE_GESTURE_NONE;
+    return POS_OSK_DELETE_GESTURE_WORDS;
+  }
+
+  if (widget_width <= 0.0 || -dx <= widget_width * POS_OSK_CHAR_GESTURE_FRACTION)
+    return POS_OSK_DELETE_GESTURE_NONE;
+
+  /* Mostly horizontal */
+  if (ABS (dy) >= -dx / 2.0)
+    return POS_OSK_DELETE_GESTURE_NONE;
+
+  return POS_OSK_DELETE_GESTURE_CHARS;
+}
