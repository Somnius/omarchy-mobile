+static void
+test_word_at_cursor (void)
+{
+  char *left = NULL;
+  char *right = NULL;
+
+  /* Greek word split by the cursor, preedit not part of surrounding text */
+  g_assert_true (pos_completer_word_at_cursor ("ok καλημέ", "", &left, &right));
+  g_assert_cmpstr (left, ==, "καλημέ");
+  g_assert_cmpuint (strlen (left), ==, strlen ("καλημέ"));
+  g_assert_null (right);
+  g_clear_pointer (&left, g_free);
+
+  /* Caret in the middle of a word with a suffix and more text after */
+  g_assert_true (pos_completer_word_at_cursor ("say hel", "lo world", &left, &right));
+  g_assert_cmpstr (left, ==, "hel");
+  g_assert_cmpstr (right, ==, "lo");
+  g_clear_pointer (&left, g_free);
+  g_clear_pointer (&right, g_free);
+
+  /* Apostrophes stay inside the word, commas split */
+  g_assert_true (pos_completer_word_at_cursor ("it's don", "t, ok", &left, &right));
+  g_assert_cmpstr (left, ==, "don");
+  g_assert_cmpstr (right, ==, "t");
+  g_clear_pointer (&left, g_free);
+  g_clear_pointer (&right, g_free);
+
+  /* Only a suffix */
+  g_assert_true (pos_completer_word_at_cursor ("ends with ", "word.", &left, &right));
+  g_assert_null (left);
+  g_assert_cmpstr (right, ==, "word");
+  g_clear_pointer (&right, g_free);
+
+  /* No word around the cursor */
+  g_assert_false (pos_completer_word_at_cursor (NULL, NULL, &left, &right));
+  g_assert_null (left);
+  g_assert_null (right);
+  g_assert_false (pos_completer_word_at_cursor ("", "", &left, &right));
+  g_assert_false (pos_completer_word_at_cursor ("ends with ", " starts with", &left, &right));
+  g_assert_null (left);
+  g_assert_null (right);
+
+  /* Invalid UTF-8 is ignored */
+  g_assert_false (pos_completer_word_at_cursor ("abc\xff", "", &left, &right));
+  g_assert_null (left);
+
+  /* Out params are optional */
+  g_assert_true (pos_completer_word_at_cursor ("word", "", NULL, NULL));
+}
+
