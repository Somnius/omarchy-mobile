 /**
+ * pos_completer_word_at_cursor:
+ * @before: (nullable): The surrounding text before the cursor
+ * @after: (nullable): The surrounding text after the cursor
+ * @left: (out) (optional): The part of the word before the cursor
+ * @right: (out) (optional): The part of the word after the cursor
+ *
+ * Finds the word the cursor is in. `left` is the tail of `before` and
+ * `right` the head of `after` up to the next word separator (see
+ * `pos_completer_symbol_is_word_separator()`). The preedit is not part of
+ * the surrounding text so it is not looked at: the caller inserts it
+ * between `left` and `right`. The byte lengths of `left` and `right`
+ * are what `delete_surrounding_text` needs to replace the word.
+ *
+ * Invalid UTF-8 is treated as empty.
+ *
+ * Returns: %TRUE if the cursor touches a word, %FALSE if both parts are empty
+ */
+gboolean
+pos_completer_word_at_cursor (const char *before, const char *after, char **left, char **right)
+{
+  const char *lstart = before;
+  const char *rend = after;
+  g_autofree char *l = NULL;
+  g_autofree char *r = NULL;
+
+  if (left)
+    *left = NULL;
+  if (right)
+    *right = NULL;
+
+  if (before && *before && g_utf8_validate (before, -1, NULL)) {
+    const char *end = before + strlen (before);
+    const char *p = end;
+
+    while (p > before) {
+      const char *prev = g_utf8_find_prev_char (before, p);
+      g_autofree char *symbol = g_strndup (prev, p - prev);
+
+      if (pos_completer_symbol_is_word_separator (symbol, NULL))
+        break;
+      p = prev;
+    }
+    lstart = p;
+    if (*lstart)
+      l = g_strdup (lstart);
+  }
+
+  if (after && *after && g_utf8_validate (after, -1, NULL)) {
+    const char *p = after;
+
+    while (*p) {
+      const char *next = g_utf8_next_char (p);
+      g_autofree char *symbol = g_strndup (p, next - p);
+
+      if (pos_completer_symbol_is_word_separator (symbol, NULL))
+        break;
+      p = next;
+    }
+    rend = p;
+    if (rend > after)
+      r = g_strndup (after, rend - after);
+  }
+
+  if (gm_str_is_null_or_empty (l) && gm_str_is_null_or_empty (r))
+    return FALSE;
+
+  if (left)
+    *left = g_steal_pointer (&l);
+  if (right)
+    *right = g_steal_pointer (&r);
+
+  return TRUE;
+}
