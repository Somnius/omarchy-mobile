+static void
+on_osk_language_swipe (PosInputSurface *self, int direction, GtkWidget *osk_widget)
+{
+  GtkWidget *visible = hdy_deck_get_visible_child (self->deck);
+  guint idx = 0;
+  PosOskWidget *next;
+
+  if (self->osks->len < 2)
+    return;
+
+  for (guint i = 0; i < self->osks->len; i++) {
+    if (g_ptr_array_index (self->osks, i) == (gpointer) visible)
+      idx = i;
+  }
+  if (!g_ptr_array_find (self->osks, visible, NULL))
+    return;
