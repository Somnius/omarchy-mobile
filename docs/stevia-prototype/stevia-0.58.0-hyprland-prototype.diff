+static gboolean
+pos_osk_widget_menu_touch (PosOskWidget *self, GdkEventTouch *event)
+{
+  int idx;
+
+  if (self->menu_n == 0)
+    return FALSE;
+
+  idx = menu_hit (self, event->x, event->y);
+  g_debug ("Menu touch type %d at (%f, %f): item %d", event->type, event->x, event->y, idx);
+
+  if (event->type == GDK_TOUCH_BEGIN) {
+    GdkRectangle r;
+
+    menu_get_rect (self, &r);
+    self->menu_touch_active = TRUE;
+    self->menu_pressed = idx;
+    if (idx < 0 && !(event->x >= r.x && event->x < r.x + r.width &&
+                     event->y >= r.y && event->y < r.y + r.height)) {
+      /* touch outside the menu closes it */
+      menu_clear_items (self);
+    }
+    gtk_widget_queue_draw (GTK_WIDGET (self));
+    return TRUE;
+  }
+
+  if (!self->menu_touch_active)
+    return self->menu_n > 0;
+
+  if (event->type == GDK_TOUCH_UPDATE) {
+    self->menu_pressed = idx;
+    gtk_widget_queue_draw (GTK_WIDGET (self));
+    return TRUE;
+  }
+
+  if (event->type == GDK_TOUCH_END || event->type == GDK_TOUCH_CANCEL) {
+    int picked = (event->type == GDK_TOUCH_END) ? idx : -1;
+
+    self->menu_touch_active = FALSE;
+    self->menu_pressed = -1;
+    if (picked >= 0) {
+      menu_clear_items (self);
+      gtk_widget_queue_draw (GTK_WIDGET (self));
+      g_signal_emit (self, signals[OSK_MENU_PICKED], 0, picked);
+    } else {
+      gtk_widget_queue_draw (GTK_WIDGET (self));
+    }
+  }
+  return TRUE;
+}
