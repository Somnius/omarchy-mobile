+/* The button of the popup under (x, y), given in @rel's coordinates (the widget
+ * the popup is relative to), or NULL. Used for press, slide and release. */
+static GtkWidget *
+pos_char_popup_button_at (PosCharPopup *self, GtkWidget *rel, double x, double y)
+{
+  GList *children = gtk_container_get_children (GTK_CONTAINER (self->symbols_grid));
+  GtkWidget *hit = NULL;
+
+  for (GList *l = children; l; l = l->next) {
+    GtkWidget *btn = l->data;
+    GtkAllocation alloc;
+    int bx = 0, by = 0;
+
+    if (!gtk_widget_translate_coordinates (btn, rel, 0, 0, &bx, &by))
+      continue;
+    gtk_widget_get_allocation (btn, &alloc);
+    if (x >= bx && x < bx + alloc.width && y >= by && y < by + alloc.height) {
+      hit = btn;
+      break;
+    }
+  }
+  g_list_free (children);
+  return hit;
+}
+
+
+/* Highlight the button under the finger while it slides over the popup. */
+void
+pos_char_popup_slide_to (PosCharPopup *self, GtkWidget *rel, double x, double y)
+{
+  GList *children;
+  GtkWidget *hit;
+
+  g_return_if_fail (POS_IS_CHAR_POPUP (self));
+
+  hit = pos_char_popup_button_at (self, rel, x, y);
+  children = gtk_container_get_children (GTK_CONTAINER (self->symbols_grid));
+  for (GList *l = children; l; l = l->next) {
+    if (l->data == hit)
+      gtk_widget_set_state_flags (l->data, GTK_STATE_FLAG_PRELIGHT, FALSE);
+    else
+      gtk_widget_unset_state_flags (l->data, GTK_STATE_FLAG_PRELIGHT);
+  }
+  g_list_free (children);
+}
+
+
+/* The finger lifted over the popup: select the button under it.
+ * Returns TRUE if a symbol was selected. */
+gboolean
+pos_char_popup_release_at (PosCharPopup *self, GtkWidget *rel, double x, double y)
+{
+  GtkWidget *hit;
+
+  g_return_val_if_fail (POS_IS_CHAR_POPUP (self), FALSE);
+
+  hit = pos_char_popup_button_at (self, rel, x, y);
+  if (hit == NULL)
+    return FALSE;
+
+  on_button_clicked (self, GTK_BUTTON (hit));
+  return TRUE;
+}
+
