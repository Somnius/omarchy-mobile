+ *
+ * Deletes one word before the cursor. A pending completer preedit counts
+ * as that word and is just dropped. Without surrounding text (or when the
+ * word is a single character) a single BackSpace is sent instead.
+ */
+static void
+pos_input_surface_delete_word_or_char (PosInputSurface *self)
+{
+  if (pos_input_surface_is_completer_active (self)) {
+    const char *preedit = pos_completer_get_preedit (self->completer);
