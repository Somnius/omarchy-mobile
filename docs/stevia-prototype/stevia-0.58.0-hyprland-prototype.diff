+static void
+on_osk_delete_gesture (PosInputSurface *self, int kind, int phase, GtkWidget *osk_widget)
+{
+  g_return_if_fail (POS_IS_INPUT_SURFACE (self));
+  g_return_if_fail (POS_IS_OSK_WIDGET (osk_widget));
+
+  g_debug ("Delete gesture: kind %d, phase %d", kind, phase);
+
+  if (kind == POS_OSK_DELETE_GESTURE_CHARS) {
+    if (phase != POS_OSK_GESTURE_PHASE_END)
+      return;
+    pos_input_surface_trigger_feedback (self, KEY_PRESS_EVENT);
+    pos_input_surface_delete_word_or_char (self);
+    return;
+  }
+
+  if (kind != POS_OSK_DELETE_GESTURE_WORDS)
+    return;
+
+  if (phase == POS_OSK_GESTURE_PHASE_BEGIN) {
+    /* The key press was cancelled by the widget so the long press timer is
+     * gone; delete a word now and keep deleting words while the finger stays */
+    g_clear_handle_id (&self->bs_repeat_id, g_source_remove);
+    pos_input_surface_set_backspace_mode (self, POS_BACKSPACE_MODE_WORD);
+    pos_input_surface_trigger_feedback (self, KEY_PRESS_EVENT);
