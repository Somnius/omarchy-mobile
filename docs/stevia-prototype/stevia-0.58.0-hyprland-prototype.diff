+/**
+ * pos_osk_widget_check_delete_gesture:
+ * @self: The osk widget
+ * @x: Current touch x
+ * @y: Current touch y
+ *
+ * Classifies the movement of the current touch sequence since it began
+ * as a delete gesture. Only in keyboard mode, while no symbol popup is
+ * shown and when keys are not retargeted by dragging.
+ *
+ * Returns: The kind of delete gesture
+ */
+static PosOskDeleteGesture
+pos_osk_widget_check_delete_gesture (PosOskWidget *self, double x, double y)
+{
+  PosOskKey *key = self->touch_start_key;
+  const char *symbol;
+  gboolean is_bs;
+  double key_width;
+
+  if (!key)
+    return POS_OSK_DELETE_GESTURE_NONE;
+
+  if (self->mode != POS_OSK_WIDGET_MODE_KEYBOARD)
+    return POS_OSK_DELETE_GESTURE_NONE;
+
+  if (self->char_popup && gtk_widget_get_visible (self->char_popup))
+    return POS_OSK_DELETE_GESTURE_NONE;
+
+  if (self->features & PHOSH_OSK_FEATURE_KEY_DRAG)
+    return POS_OSK_DELETE_GESTURE_NONE;
+
+  is_bs = pos_osk_key_get_use (key) == POS_OSK_KEY_USE_DELETE;
+  symbol = pos_osk_key_get_symbol (key);
+  if (!is_bs) {
+    /* Only plain character keys start the single delete */
+    if (pos_osk_key_get_use (key) != POS_OSK_KEY_USE_KEY)
+      return POS_OSK_DELETE_GESTURE_NONE;
+    if (!symbol || g_str_has_prefix (symbol, "KEY_") || g_str_equal (symbol, POS_OSK_SYMBOL_SPACE))
+      return POS_OSK_DELETE_GESTURE_NONE;
+  }
+
+  key_width = pos_osk_key_get_box (key)->width;
+
+  return pos_osk_classify_delete_gesture (is_bs,
+                                          x - self->touch_start_x,
+                                          y - self->touch_start_y,
+                                          key_width,
+                                          self->width);
+}
+
+
+/* In-surface layout menu.
+ *
+ * A GtkPopover on a layer-shell surface becomes a separate xdg_popup whose
+ * touch input is offset from what is drawn on the phone. So the menu is
+ * drawn by the osk widget itself and hit-tested here with the same touch
+ * coordinates the keys use. */
+#define MENU_ITEM_H 40
+#define MENU_W 200
+#define MENU_PAD 6
+
+static void
+menu_clear_items (PosOskWidget *self)
+{
+  g_clear_pointer (&self->menu_labels, g_strfreev);
+  self->menu_n = 0;
+  self->menu_pressed = -1;
+}
+
+
+static void
+menu_get_rect (PosOskWidget *self, GdkRectangle *r)
+{
+  int h = self->menu_n * MENU_ITEM_H + 2 * MENU_PAD;
+
+  r->width = MENU_W;
+  r->height = h;
+  r->x = CLAMP (self->menu_anchor_x - 24, 4, MAX (4, self->width - MENU_W - 4));
+  r->y = MAX (2, self->menu_anchor_y - 14 - h);
+}
+
+
+static int
+menu_hit (PosOskWidget *self, double x, double y)
+{
+  GdkRectangle r;
+  int idx;
+
+  menu_get_rect (self, &r);
+  if (x < r.x || x >= r.x + r.width || y < r.y + MENU_PAD || y >= r.y + r.height - MENU_PAD)
+    return -1;
+  idx = (int) ((y - r.y - MENU_PAD) / MENU_ITEM_H);
+  return idx < self->menu_n ? idx : -1;
+}
+
+
+void
+pos_osk_widget_close_menu (PosOskWidget *self)
+{
+  g_return_if_fail (POS_IS_OSK_WIDGET (self));
+
+  if (self->menu_n == 0)
+    return;
+  menu_clear_items (self);
+  gtk_widget_queue_draw (GTK_WIDGET (self));
+}
+
+
+/**
+ * pos_osk_widget_open_menu:
+ * @labels: (array length=n): item labels
+ * @checked: index of the item drawn as selected, or -1
+ * @toggled: for items listed in @toggles (bitmask) a checked/unchecked state
+ *
+ * Opens the layout menu above the given anchor point. Picking an item emits
+ * "menu-picked" with its index.
+ */
+void
+pos_osk_widget_open_menu (PosOskWidget *self,
+                          const char  **labels,
+                          int           n,
+                          int           checked,
+                          guint         checked_mask,
+                          int           anchor_x,
+                          int           anchor_y)
+{
+  g_return_if_fail (POS_IS_OSK_WIDGET (self));
+
+  menu_clear_items (self);
+  self->menu_labels = g_strdupv ((char **) labels);
+  self->menu_n = n;
+  self->menu_checked = checked;
+  self->menu_checked_mask = checked_mask;
+  self->menu_anchor_x = anchor_x;
+  self->menu_anchor_y = anchor_y;
+  self->menu_pressed = -1;
+  gtk_widget_queue_draw (GTK_WIDGET (self));
+}
+
+
+static void
+menu_draw (PosOskWidget *self, cairo_t *cr)
+{
+  GtkStyleContext *ctx = self->key_context;
+  GtkStateFlags state = gtk_style_context_get_state (ctx);
+  GdkRGBA fg, bg;
+  GdkRectangle r;
+  PangoFontDescription *font = NULL;
+  PangoLayout *layout;
+
+  if (self->menu_n == 0)
+    return;
+
+  gtk_style_context_get_color (ctx, state, &fg);
+  gtk_style_context_get (ctx, state, "background-color", &bg, "font", &font, NULL);
+  menu_get_rect (self, &r);
+
+  cairo_save (cr);
+  cairo_set_source_rgba (cr, 0, 0, 0, 0.45);
+  cairo_rectangle (cr, r.x + 2, r.y + 3, r.width, r.height);
+  cairo_fill (cr);
+  cairo_set_source_rgb (cr, bg.red * 0.55, bg.green * 0.55, bg.blue * 0.55);
+  cairo_rectangle (cr, r.x, r.y, r.width, r.height);
+  cairo_fill (cr);
+  cairo_set_source_rgba (cr, fg.red, fg.green, fg.blue, 0.35);
+  cairo_set_line_width (cr, 1);
+  cairo_rectangle (cr, r.x + 0.5, r.y + 0.5, r.width - 1, r.height - 1);
+  cairo_stroke (cr);
+
+  layout = gtk_widget_create_pango_layout (GTK_WIDGET (self), NULL);
+  if (font)
+    pango_layout_set_font_description (layout, font);
+
+  for (int i = 0; i < self->menu_n; i++) {
+    int y = r.y + MENU_PAD + i * MENU_ITEM_H;
