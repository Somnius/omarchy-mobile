+  idx = (idx + self->osks->len + direction) % self->osks->len;
+  next = g_ptr_array_index (self->osks, idx);
+  g_debug ("Language swipe %d: switching to '%s'", direction, pos_osk_widget_get_name (next));
+  g_action_group_activate_action (G_ACTION_GROUP (self->action_map), "select-layout",
+                                  g_variant_new_string (pos_osk_widget_get_name (next)));
