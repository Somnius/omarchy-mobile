+  g_assert_cmpint (pos_osk_classify_delete_gesture (TRUE, -41.0, 0.0, KEY_W, WIDGET_W), ==,
+                   POS_OSK_DELETE_GESTURE_WORDS);
+  g_assert_cmpint (pos_osk_classify_delete_gesture (TRUE, -200.0, 30.0, KEY_W, WIDGET_W), ==,
+                   POS_OSK_DELETE_GESTURE_WORDS);
+  /* Not far enough, to the right, or straight down: nothing */
+  g_assert_cmpint (pos_osk_classify_delete_gesture (TRUE, -40.0, 0.0, KEY_W, WIDGET_W), ==,
+                   POS_OSK_DELETE_GESTURE_NONE);
+  g_assert_cmpint (pos_osk_classify_delete_gesture (TRUE, -10.0, 0.0, KEY_W, WIDGET_W), ==,
+                   POS_OSK_DELETE_GESTURE_NONE);
+  g_assert_cmpint (pos_osk_classify_delete_gesture (TRUE, 100.0, 0.0, KEY_W, WIDGET_W), ==,
+                   POS_OSK_DELETE_GESTURE_NONE);
+  g_assert_cmpint (pos_osk_classify_delete_gesture (TRUE, 0.0, 100.0, KEY_W, WIDGET_W), ==,
+                   POS_OSK_DELETE_GESTURE_NONE);
+  /* Unknown key width */
+  g_assert_cmpint (pos_osk_classify_delete_gesture (TRUE, -100.0, 0.0, 0.0, WIDGET_W), ==,
+                   POS_OSK_DELETE_GESTURE_NONE);
+}
+
+
+static void
+test_classify_letter (void)
+{
+  /* Slide left over a quarter of the widget, mostly horizontal: one delete */
+  g_assert_cmpint (pos_osk_classify_delete_gesture (FALSE, -101.0, 0.0, KEY_W, WIDGET_W), ==,
+                   POS_OSK_DELETE_GESTURE_CHARS);
+  g_assert_cmpint (pos_osk_classify_delete_gesture (FALSE, -120.0, 59.0, KEY_W, WIDGET_W), ==,
+                   POS_OSK_DELETE_GESTURE_CHARS);
+  g_assert_cmpint (pos_osk_classify_delete_gesture (FALSE, -120.0, -59.0, KEY_W, WIDGET_W), ==,
+                   POS_OSK_DELETE_GESTURE_CHARS);
+  /* Too short */
+  g_assert_cmpint (pos_osk_classify_delete_gesture (FALSE, -100.0, 0.0, KEY_W, WIDGET_W), ==,
+                   POS_OSK_DELETE_GESTURE_NONE);
+  g_assert_cmpint (pos_osk_classify_delete_gesture (FALSE, -41.0, 0.0, KEY_W, WIDGET_W), ==,
+                   POS_OSK_DELETE_GESTURE_NONE);
+  /* Diagonal or down */
+  g_assert_cmpint (pos_osk_classify_delete_gesture (FALSE, -120.0, 60.0, KEY_W, WIDGET_W), ==,
+                   POS_OSK_DELETE_GESTURE_NONE);
+  g_assert_cmpint (pos_osk_classify_delete_gesture (FALSE, -120.0, 200.0, KEY_W, WIDGET_W), ==,
+                   POS_OSK_DELETE_GESTURE_NONE);
+  g_assert_cmpint (pos_osk_classify_delete_gesture (FALSE, 0.0, 200.0, KEY_W, WIDGET_W), ==,
+                   POS_OSK_DELETE_GESTURE_NONE);
+  /* Right */
+  g_assert_cmpint (pos_osk_classify_delete_gesture (FALSE, 200.0, 0.0, KEY_W, WIDGET_W), ==,
+                   POS_OSK_DELETE_GESTURE_NONE);
+  /* Unknown widget width */
+  g_assert_cmpint (pos_osk_classify_delete_gesture (FALSE, -200.0, 0.0, KEY_W, 0.0), ==,
+                   POS_OSK_DELETE_GESTURE_NONE);
+}
+
+
+int
+main (int argc, char *argv[])
+{
+  g_test_init (&argc, &argv, NULL);
+
+  g_test_add_func ("/pos/osk-gesture/classify/backspace", test_classify_backspace);
+  g_test_add_func ("/pos/osk-gesture/classify/letter", test_classify_letter);
+
+  return g_test_run ();
+}
